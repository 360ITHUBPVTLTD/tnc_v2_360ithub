{
 "align_labels_right": 0,
 "creation": "2026-10-07 12:00:00.000000",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Teacher Settlement",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 12,
 "html": "<div class=\"tp\">\n{%- set v = tnc_statement_view(doc) -%}\n{%- set lh = tnc_letterhead(doc.company if doc.company else None) -%}\n<style>\n  .tp{font-family:\"Helvetica Neue\",Arial,Helvetica,sans-serif;color:#1f2937;font-size:11.5px;line-height:1.45}\n  .tp table{border-collapse:collapse;width:100%}\n  .tp .lh{border:1.5px solid #1f3c88;border-radius:6px}\n  .tp .lh td{vertical-align:middle;padding:12px 14px}\n  .tp .lh .logo{width:110px;border-right:1px solid #dbe3f3;text-align:center}\n  .tp .lh .logo img{width:92px;height:92px}\n  .tp .inst{font-size:22px;font-weight:800;color:#c62828;letter-spacing:.02em;margin:0 0 3px}\n  .tp .addr{color:#1f3c88;font-size:11px}\n  .tp .contact{color:#374151;font-size:11px;margin-top:3px}\n  .tp .band{margin:14px 0 12px;background:#1f3c88;color:#fff;border-radius:4px}\n  .tp .band td{color:#fff;padding:8px 12px;font-size:13px;font-weight:700;letter-spacing:.12em}\n  .tp .band .r{color:#fff;text-align:right;font-weight:400;letter-spacing:0;font-size:11px}\n  .tp .box{border:1px solid #d1d9e6;border-radius:6px}\n  .tp .box td{padding:4px 12px;vertical-align:top}\n  .tp .k{color:#6b7280;width:105px;white-space:nowrap}\n  .tp .v{font-weight:600}\n  .tp .who{font-size:15px;font-weight:800;color:#111827;padding-top:10px}\n  .tp .grid th{background:#eef2fb;color:#1f3c88;font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:7px 9px;border:1px solid #d1d9e6}\n  .tp .grid td{padding:7px 9px;border:1px solid #e3e8f0;vertical-align:top}\n  .tp .n{text-align:right;white-space:nowrap}\n  .tp .muted{color:#6b7280;font-size:10.5px}\n  .tp .neg{color:#b42318}\n  .tp .pos{color:#067647}\n  .tp .sum td{padding:6px 12px;border-bottom:1px solid #eef1f6}\n  .tp .sum .total td{border-top:2px solid #1f3c88;border-bottom:0;font-size:15px;font-weight:800;color:#1f3c88;background:#f5f8ff}\n  .tp .foot{margin-top:22px;text-align:center;color:#9ca3af;font-size:10px;border-top:1px dashed #e5e7eb;padding-top:8px}\n</style>\n<table class=\"lh\"><tr>\n  {% if lh.logo %}<td class=\"logo\"><img src=\"{{ lh.logo }}\"></td>{% endif %}\n  <td>\n    <div class=\"inst\">{{ (lh.name or \"\").upper() }}</div>\n    {% if lh.address %}<div class=\"addr\">{{ lh.address }}</div>{% endif %}\n    {% if lh.gstin %}<div class=\"addr\">GSTIN: {{ lh.gstin }}</div>{% endif %}\n    {% set parts = [] %}{% if lh.phone %}{% set _ = parts.append(\"Mobile: \" ~ lh.phone) %}{% endif %}{% if lh.email %}{% set _ = parts.append(\"Email: \" ~ lh.email) %}{% endif %}{% if lh.website %}{% set _ = parts.append(lh.website) %}{% endif %}\n    {% if parts %}<div class=\"contact\">{{ parts | join(\"  |  \") }}</div>{% endif %}\n  </td>\n</tr></table>\n\n<table class=\"band\"><tr><td>WEEKLY PAYMENT STATEMENT</td><td class=\"r\">{{ frappe.format_value(doc.week_start, {\"fieldtype\": \"Date\"}) }} to {{ frappe.format_value(doc.week_end, {\"fieldtype\": \"Date\"}) }}</td></tr></table>\n<table class=\"box\"><tr>\n  <td style=\"width:55%\">\n    <div class=\"muted\">Statement for</div>\n    <div class=\"who\">{{ (doc.teacher_name or doc.teacher).strip() }}</div>\n  </td>\n  <td>\n    <table>\n      <tr><td class=\"k\">Week</td><td class=\"v\">Saturday to Friday</td></tr>\n      <tr><td class=\"k\">Statement No.</td><td class=\"v\">{{ doc.name }}</td></tr>\n    </table>\n  </td>\n</tr></table>\n<br>\n<table><tr><td style=\"width:45%;vertical-align:top;padding-right:14px\">\n  <table class=\"sum box\">\n    {% for label, amount, sign in v.summary %}\n    <tr class=\"{{ 'total' if sign == '=' else '' }}\">\n      <td>{% if sign and sign != '=' %}<b class=\"{{ 'pos' if sign == '+' else 'neg' }}\">{{ sign }}</b> {% endif %}{{ label }}</td>\n      <td class=\"n\">{{ frappe.format_value(amount, {\"fieldtype\": \"Currency\"}) }}</td>\n    </tr>\n    {% endfor %}\n  </table>\n</td><td style=\"vertical-align:top\">\n  <table class=\"grid\">\n    <tr><th style=\"width:92px\">Date</th><th>Details</th><th class=\"n\">Amount</th></tr>\n    {% for l in v.lines %}\n    <tr><td style=\"white-space:nowrap\">{{ frappe.format_value(l.date, {\"fieldtype\": \"Date\"}) if l.date else \"\" }}</td><td>{{ l.details }}<div class=\"muted\">{{ l.ref }}</div></td>\n      <td class=\"n {{ 'pos' if l.amount > 0 else 'neg' }}\">{{ '+' if l.amount > 0 else '-' }} {{ frappe.format_value(l.amount | abs, {\"fieldtype\": \"Currency\"}) }}</td></tr>\n    {% else %}\n    <tr><td colspan=\"3\" class=\"muted\">Nothing this week.</td></tr>\n    {% endfor %}\n  </table>\n</td></tr></table>\n<div class=\"foot\">This is a computer generated statement. Questions? Please contact the office.</div>\n</div>\n",
 "idx": 0,
 "line_breaks": 0,
 "margin_bottom": 12,
 "margin_left": 12,
 "margin_right": 12,
